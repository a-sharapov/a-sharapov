FROM oven/bun:1.4.3-alpine AS builder

ARG TG_ROOT=/var/www/bot

WORKDIR ${TG_ROOT}

COPY bot/package.json bot/bun.lock ./
RUN bun install --frozen-lockfile --production

COPY bot/tsconfig.json bot/main.ts ./
COPY bot/assets ./assets
COPY bot/l18n ./l18n
COPY bot/repo ./repo

ENV NODE_ENV=production
RUN bun build --compile --outfile=./dist/bot ./main.ts

FROM alpine:3.22 AS runtime

ARG TG_PORT=5702
ARG TG_ROOT=/var/www/bot
ARG UID=1000
ARG GID=1000

ENV UID=${UID}
ENV GID=${GID}
ENV NODE_ENV=production
ENV TG_PORT=${TG_PORT}

RUN set -eux; \
  apk add --no-cache ca-certificates libstdc++ libgcc su-exec; \
  addgroup -g "${GID}" bot 2>/dev/null || addgroup bot; \
  adduser -D -H -u "${UID}" -G bot bot; \
  mkdir -p "${TG_ROOT}/data"; \
  chown -R bot:bot "${TG_ROOT}"

WORKDIR ${TG_ROOT}

COPY --from=builder --chown=bot:bot ${TG_ROOT}/dist/bot ./bot
COPY --chown=root:root bot/entrypoint.sh /usr/local/bin/bot-entrypoint
RUN chmod +x /usr/local/bin/bot-entrypoint

EXPOSE ${TG_PORT}

USER root
ENTRYPOINT ["bot-entrypoint"]
CMD ["./bot"]
