FROM oven/bun:1.4.4

ARG WEB_PORT=5701
ARG WEB_ROOT=/var/www/web
ARG UID=1000
ARG GID=1000

WORKDIR ${WEB_ROOT}
COPY package.json bun.lock* ./
RUN bun install
COPY . .

RUN chown -R ${UID}:${GID} ${WEB_ROOT}
USER ${UID}:${GID}

EXPOSE ${WEB_PORT}
CMD ["bun", "--bun", "./node_modules/vite/bin/vite.js", "dev", "--host", "0.0.0.0", "--port", "5701"]
