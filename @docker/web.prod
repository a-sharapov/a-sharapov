FROM oven/bun:1.4.4 AS builder

WORKDIR /var/www/web
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build

FROM oven/bun:1.4.4-alpine AS runtime

ARG WEB_PORT=5701

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=${WEB_PORT}
ENV BODY_SIZE_LIMIT=64K

WORKDIR /var/www/web
COPY --from=builder --chown=bun:bun /var/www/web/package.json ./package.json
COPY --from=builder --chown=bun:bun /var/www/web/build ./build
RUN install -d -o bun -g bun .cache

USER bun
EXPOSE ${WEB_PORT}
CMD ["bun", "./build"]
