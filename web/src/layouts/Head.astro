---
import { ClientRouter } from 'astro:transitions';
import { OG_COVERS, THEME_COLOR } from '$lib/common/constants';
import { hrefFor } from '$lib/common/routes';
import { siteGraph } from '$lib/common/seo';
import { localize } from '$lib/common/utils';
import content from '$lib/services/content';

export interface IHead {
  title: string;
  description: string;
  keywords: string;
  robots: string;
  cover: string;
  coverAlt: string;
  schema: Record<string, unknown>[];
  markdown: string;
  ogType: 'website' | 'profile';
}

const t = localize(Astro.locals.i18n ?? {});
const {
  title = '',
  description = '',
  keywords = '',
  robots = 'index, follow',
  cover = OG_COVERS.index,
  coverAlt = '',
  schema = [],
  markdown = '',
  ogType = 'website',
} = Astro.props satisfies Partial<IHead>;

const origin = (Astro.site ?? Astro.url).origin;
const indexable = !robots.includes('noindex');
const route = Astro.locals.slug ? { locale: Astro.locals.locale, slug: Astro.locals.slug } : null;
const canonical = new URL(route ? hrefFor(route) : Astro.url.pathname, origin).toString();
const coverUrl = new URL(cover ?? OG_COVERS.index!, origin).toString();
const pageTitle = title || t('meta.title');
const pageDescription = description || t('meta.description');
const contacts = await content.contacts.list();
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [...siteGraph({ origin, dictionary: Astro.locals.i18n ?? {}, contacts }), ...schema],
}).replaceAll('<', '\\u003c');
---

<head>
  <ClientRouter fallback="swap" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <script is:inline src="/js/shell-init.js"></script>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content={keywords || t('meta.keywords')} />
  <meta name="robots" content={robots} />
  <meta name="theme-color" content={THEME_COLOR} />
  {indexable && <link rel="canonical" href={canonical} />}
  {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link
    rel="preload"
    href="/fonts/pt-sans-400-cyrillic.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    rel="preload"
    href="/fonts/pt-sans-narrow-400-cyrillic.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link rel="stylesheet" href="/css/fonts.css" />
  <link rel="stylesheet" href="/css/normalize.css" />
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/base.css" />
  <meta property="og:type" content={ogType} />
  {ogType === 'profile' && <meta property="profile:first_name" content={t('seo.givenName')} />}
  {ogType === 'profile' && <meta property="profile:last_name" content={t('seo.familyName')} />}
  <meta property="og:site_name" content={t('profile.name')} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={coverUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={coverAlt || pageTitle} />
  <meta property="og:locale" content="ru_RU" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={ld} />
  <slot />
</head>
