---
import ModelLab from '$lib/components/@Viewer/Lab/ModelLab.svelte';

if (import.meta.env.PROD) return new Response(null, { status: 404 });

const name = Astro.url.searchParams.get('name') ?? 'cup';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Model lab · {name}</title>
    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #d8d0c2;
      }
    </style>
  </head>
  <body>
    <ModelLab client:only="svelte" model={name} />
  </body>
</html>
