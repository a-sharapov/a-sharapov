---
import { PRIVACY_SLUG } from '$lib/common/constants';
import { hrefFor, shotFor } from '$lib/common/routes';
import { localize } from '$lib/common/utils';
import './Footer.css';

interface Props {
  t: Record<string, unknown>;
}

const t = localize(Astro.props.t ?? {});
const year = new Date().getFullYear();
const privacyHref = hrefFor({
  locale: Astro.locals.locale,
  slug: PRIVACY_SLUG,
});
---

<footer class="colophon">
  <p class="copyleft">
    <span class="years">2011 – {year}</span>
    <span class="glyph" aria-hidden="true">©</span>
    {t('footer.copyleft')}
    <span class="divider" aria-hidden="true">·</span>
    <a href={privacyHref} data-shot={shotFor('resume')}>{t('footer.privacy')}</a>
  </p>
</footer>
