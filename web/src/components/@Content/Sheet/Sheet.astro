---
import type { Shot } from '$lib/common/types';
import './Sheet.css';
import '$lib/styles/Article.css';
import '$lib/styles/Services.css';

interface Props {
  shot: Shot;
  layout: string;
}

const { shot, layout } = Astro.props;
---

<article class="sheet" data-shot={shot} data-layout={layout}><slot /></article>
