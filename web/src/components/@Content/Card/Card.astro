---
import type { ContactKind, ContactRecord } from '$lib/common/types';
import { localize, splitLabel } from '$lib/common/utils';
import Mail from '/i/mail.svg?raw';
import Phone from '/i/phone.svg?raw';
import Telegram from '/i/telegram.svg?raw';
import Turn from '/i/turn.svg?raw';
import Logo from '/logo.svg?raw';
import './Card.css';

interface Props {
  t: Record<string, unknown>;
  href: string;
  content: string;
  contacts: ContactRecord[];
}

const _ICONS: Partial<Record<ContactKind, string>> = {
  phone: Phone,
  telegram: Telegram,
  email: Mail,
};

const { t: dictionary, href, content, contacts } = Astro.props;
const t = localize(dictionary ?? {});
const reach = contacts
  .filter(({ kind }) => kind in _ICONS)
  .map((contact, index, list) => ({
    href: contact.href,
    icon: list[index - 1]?.kind === contact.kind ? '' : (_ICONS[contact.kind] ?? ''),
    parts: splitLabel(contact.label),
  }));
---

<section class="card" aria-labelledby="card-title">
  <h1 id="card-title" class="logo">
    <span aria-hidden="true" set:html={Logo} />
    <span class="sr-only">{t('profile.name')} — {t('profile.role')}</span>
  </h1>
  <p class="tagline">
    <span class="idle">{t('profile.tagline')}</span>
    <a class="cta" href={href}>{t('profile.taglineHover')}</a>
  </p>
</section>

<div class="paper-card">
  <div class="turn">
    <button type="button" class="face" aria-label={t('a11y.flipCard')}>
      <span class="logo" aria-hidden="true" set:html={Logo} />
      <span class="tagline" aria-hidden="true">{t('profile.tagline')}</span>
      <span class="hint" aria-hidden="true" set:html={Turn} />
    </button>
    <div class="back" inert>
      <p class="name">{t('profile.name')}</p>
      <p class="role">{t('profile.role')}</p>
      <ul>
        {reach.map(({ href: link, icon, parts: { 0: head, 1: tail } }) => (
          <li>
            <span class="icon" aria-hidden="true" set:html={icon} />
            <a href={link}>
              {head}
              {tail && <strong>{tail}</strong>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

{content && <div class="intro" set:html={content} />}

<script>
  const _bind = () =>
    document.querySelectorAll<HTMLElement>('.paper-card').forEach((card) => {
      const face = card.querySelector<HTMLElement>('.face')!;
      const back = card.querySelector<HTMLElement>('.back')!;
      const flip = (flipped: boolean) =>
        void (card.toggleAttribute('data-flipped', flipped),
        face.toggleAttribute('inert', flipped),
        back.toggleAttribute('inert', !flipped),
        (flipped ? back.querySelector('a') : face)?.focus({
          preventScroll: true,
        }));
      face.addEventListener('click', () => flip(true));
      back.addEventListener(
        'click',
        (event) => void ((event.target as Element).closest('a') || flip(false))
      );
      card.addEventListener('keydown', (event) => void (event.key === 'Escape' && flip(false)));
    });

  document.addEventListener('astro:page-load', _bind);
</script>
