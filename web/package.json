{
  "name": "a-sharapov-web",
  "type": "module",
  "version": "7.0.0",
  "private": true,
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "bun ./build",
    "preview": "bun --bun vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "test": "bun test src",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "1.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@threlte/core": "^8.6.1",
    "@threlte/extras": "^9.22.3",
    "@types/bun": "^1.4.3",
    "@types/three": "0.186.0",
    "pocketbase": "^0.28.1",
    "svelte": "^5.57.2",
    "svelte-check": "4.7.7",
    "three": "0.186.1",
    "typescript": "^6.0.3",
    "vite": "8.3.5"
  }
}
