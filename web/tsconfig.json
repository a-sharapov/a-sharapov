{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["node_modules/*", "dist/*"],
  "compilerOptions": {
    "strictNullChecks": true,
    "module": "esnext",
    "target": "esnext",
    "types": ["bun"],
    "paths": {
      "$lib/*": ["./src/*"]
    },
    "sourceMap": true,
    "allowJs": true
  }
}
