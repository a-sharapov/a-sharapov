# a-sharapov — переменные окружения. Генерируется: bun scripts/env/generate.ts example
# Манифест — scripts/env/keys.toml: кому раздаётся ключ и откуда значение.
#
# Новый .env: make dot-env (секреты сгенерируются сами). Вручную — только внешние ключи
# (TG_TOKEN) и то, что отличается от умолчания. make env раскладывает .env по env/<сервис>.env.

# -- Режим и скрипты хоста --
# Режим: dev — локально, prod — сервер (Caddy ACME + HTTP/3).
# варианты: dev | prod
ENV=dev
# Адрес CMS для make cms-seed с хоста. (только для хоста)
# CMS_URL=http://localhost:5703
# Порт хоста для HTTP proxy (dev: другой, если 80 занят). (только для хоста)
# PROXY_HTTP_PORT=80
# Порт хоста для HTTPS и HTTP/3 proxy. (только для хоста)
# PROXY_HTTPS_PORT=443

# -- Proxy: домен и сертификаты Caddy --
# Домен сайта; в prod Caddy выпускает сертификаты на него и www. (в prod: a-sharapov.com)
DOMAIN=localhost
# Email аккаунта Let's Encrypt.
# ACME_EMAIL=webmaster@a-sharapov.com

# -- Web: сайт на SvelteKit --
# Порт SvelteKit в сети compose.
# WEB_PORT=5701
# PocketBase внутри сети compose. (выводится сам)
# PB_URL=http://cms:5703
# HTTP API бота внутри сети compose. (выводится сам)
# BOT_URL=http://bot:5702
# Кэш контента CMS: file — память процесса и файлы .cache/content (в prod — том web_cache; переживают перезапуск и отказ CMS), memory — только память процесса.
# варианты: file | memory
# CACHE_STRATEGY=file

# -- Telegram-бот --
# Порт HTTP API бота.
# TG_PORT=5702
# Токен бота от @BotFather. (вписать вручную; в prod обязателен)
TG_TOKEN=
# Ключи подписки менеджеров на уведомления, через запятую. (генерируется автоматически)
# TG_MANAGER_TOKEN=
# Токен запросов web → HTTP API бота. (генерируется автоматически)
# BOT_SERVICE_TOKEN=
# SQLite бота относительно /var/www/bot (том ./bot/data).
# BOT_DB_PATH=./data/bot.db

# -- CMS: PocketBase --
# Порт PocketBase.
# CMS_PORT=5703
# Email суперпользователя PocketBase (make cms-admin).
# CMS_LOGIN=admin@a-sharapov.com
# Пароль суперпользователя PocketBase. (генерируется автоматически)
# CMS_PASSWORD=
